/* cal-menu theme — Catppuccin Mocha, matches tsmenu popup look */
* {
    font: "JetBrainsMono Nerd Font 10";
    background-color: transparent;
    text-color: #cdd6f4ff;
}

window {
    anchor: northeast;
    location: northeast;
    x-offset: -20px;
    y-offset: 30px;
    width: 270px;
    padding: 8px 6px;
    background-color: #1e1e2edd;
    border: 2px;
    border-color: #a979ecff;
    border-radius: 12px;
}

inputbar {
    padding: 4px 8px;
    children: [ prompt ];
}

prompt {
    text-color: #a979ecff;
    font: "JetBrainsMono Nerd Font Bold 11";
    margin: 0 4px 0 0;
}

listview {
    lines: 16;
    fixed-height: false;
    scrollbar: false;
    spacing: 0;
    padding: 4px 0 0 0;
}

element {
    padding: 1px 8px;
    border-radius: 6px;
}

element normal.active, element normal.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: #89b4faff;
    text-color: #1e1e2eff;
    border-radius: 6px;
}
