/* ts-menu theme — Catppuccin Mocha, matches fuzzel popup look */
* {
    font: "JetBrainsMono Nerd Font 8";
    background-color: transparent;
    text-color: #cdd6f4ff;
}

window {
    anchor: northeast;
    location: northeast;
    x-offset: -20px;
    y-offset: 30px;
    width: 320px;
    padding: 8px 6px;
    background-color: #1e1e2edd;
    border: 2px;
    border-color: #a979ecff;
    border-radius: 12px;
}

inputbar {
    padding: 4px 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: #6c7086ff;
    margin: 0 4px 0 0;
}

entry {
    text-color: #cdd6f4ff;
    placeholder: "";
}

listview {
    lines: 7;
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
    padding: 4px 0 0 0;
}

element {
    padding: 2px 8px;
    border-radius: 6px;
}

element normal.active, element normal.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: #89b4faff;
    text-color: #1e1e2eff;
    border-radius: 6px;
}
